# =====================================================================
# cvehub 設定檔（install.sh 會複製成 .env 並填好「A」；.env 權限 600、不要進 git）
# 改完設定：sudo docker compose up -d（「A. 建置」的設定要重建：sudo docker compose up -d --build）
# =====================================================================

# ---------------------------------------------------------------------
# A. 安裝時填（install.sh 會問）
# ---------------------------------------------------------------------
# 主機來源：file＝匯入主機清單 CSV（README「主機清單」）；landscape＝從 Landscape API 同步（填 C、D）
HOST_SOURCE=file
# 要比對的 Ubuntu 版本（逗號分隔；Pro／ESM 會一併匯入）
UBUNTU_RELEASES=20.04,22.04,24.04
TZ=Asia/Taipei
# 網頁的主機 port（瀏覽器連 http://<主機>:<這個 port>/）；只給本機反向代理連時寫 127.0.0.1:8080
WEB_HOST_PORT=8080
# 建置：基礎 image（主機不能 docker pull 時要先 docker load 進來）
BASE_IMAGE=python:3.12-slim
# 建置：Python 套件來源，例：https://nexus.example.com/repository/pypi-proxy/simple
PIP_INDEX_URL=https://pypi.org/simple
# 建置：套件來源是自簽憑證時填它的主機名稱（例：nexus.example.com）；公開憑證留空
PIP_TRUSTED_HOST=
# 建置：連套件來源要經過 proxy 才填
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=
# 建置：這一套的 image 名稱（不含版本；install.sh 依安裝目錄決定：/opt/cvehub＝cvehub、/opt/cvehub-test＝cvehub-test）
# 同一台主機的每一套要不同，重新建置、更新失敗還原時才不會改到別套用的 image
CVEHUB_IMAGE=cvehub
# 網站標示：同一台主機有兩套以上（例如正式、測試）時用來分辨，顯示在每一頁最上方與瀏覽器分頁標題；留空＝不顯示
SITE_LABEL=
# 標示的顏色：red | orange | green | blue | purple | gray，或 #rrggbb（留空＝orange）
SITE_COLOR=

# ---------------------------------------------------------------------
# B. 主機清單匯入（HOST_SOURCE=file）
# ---------------------------------------------------------------------
# merge＝檔案裡沒有的主機保留上次資料；replace＝檔案代表全部主機，沒列出的停用
HOSTS_FILE_MODE=merge
# 放檔目錄（排程依 SCHEDULE_OSV_CHECK 檢查）、保存目錄、保留份數
HOSTS_INBOX_DIR=/data/hosts-inbox
HOSTS_ARCHIVE_DIR=/data/hosts-archive
HOSTS_KEEP_FILES=30

# ---------------------------------------------------------------------
# C. Landscape API（HOST_SOURCE=landscape 才用；legacy API GetComputers、GetPackages）
#    建議用「只能檢視電腦」的專用帳號產生金鑰
# ---------------------------------------------------------------------
LANDSCAPE_API_URI=https://landscape.example.com/api/
LANDSCAPE_API_KEY=CHANGE_ME
LANDSCAPE_API_SECRET=CHANGE_ME
# 自簽憑證時的 CA（容器內路徑，檔案放 config/）；公開憑證留空
LANDSCAPE_CA_FILE=/config/landscape_server_ca.crt
# 只同步符合條件的電腦（Landscape 搜尋語法，例 tag:prod）；留空＝全部
LANDSCAPE_QUERY=
LANDSCAPE_TIMEOUT=300
LANDSCAPE_RETRIES=3
# Landscape 回傳的電腦比目前啟用中的少超過這個百分比（或變成 0 台）時，同步失敗、不停用主機（多半是 API 或權限出問題）；
# 真的一次下架很多台時暫時調高；0＝只擋 0 台
LANDSCAPE_MAX_DROP_PERCENT=50

# ---------------------------------------------------------------------
# D. kernel API（HOST_SOURCE=landscape 才用；提供每台主機執行中的 kernel，README 附錄）
#    留空 KERNEL_API_URL＝不使用，改用「最新安裝的 kernel」推測
# ---------------------------------------------------------------------
KERNEL_API_URL=
# per-host：每台查一次，URL 用 {hostname} {shortname} {ip}；bulk：一次回傳全部主機
KERNEL_API_MODE=per-host
# none | token | bearer | basic
KERNEL_API_AUTH=token
KERNEL_API_TOKEN=CHANGE_ME
KERNEL_API_USER=
KERNEL_API_PASSWORD=
KERNEL_API_CA_FILE=
KERNEL_API_TIMEOUT=60
# 回傳 JSON 的欄位名稱
KERNEL_API_FIELD_HOST=hostname
KERNEL_API_FIELD_VERSION=kernel_version
KERNEL_API_FIELD_RELEASE=kernel_release
KERNEL_API_FIELD_COLLECTED_AT=collected_at
# kernel 資料超過幾小時視為過期（不採用）
KERNEL_API_MAX_AGE_HOURS=48
# Landscape 與 kernel API 用什麼對上同一台：hostname | shortname（第一段）| ip
# 也決定主機名稱怎麼存與比對（不分大小寫）：shortname＝只存第一段（完整名稱另存），清單的 web01 與 Landscape 的
# web01.example.com 是同一台；hostname、ip＝存完整名稱，名稱要完全相同才算同一台
HOST_MATCH_KEY=shortname
HOST_MATCH_CASE_INSENSITIVE=true

# ---------------------------------------------------------------------
# 以下通常不用改
# ---------------------------------------------------------------------
# 比對規則
# Ubuntu Pro：auto（看回報的 Pro 狀態，沒有時看 +esm 版本）| yes | no
PRO_MODE=auto
# 是否列出「尚未有修正」的 CVE（數量很多，主要是 kernel）
INCLUDE_UNFIXED=false
# 報表最低等級：negligible | low | medium | high | critical
MIN_PRIORITY=low
# 沒有執行中 kernel 資料時，舊 kernel 套件是否也檢查
CHECK_OLD_KERNELS=false

# 排程（cron 格式，時區見 TZ）：同步、檢查放檔目錄
SCHEDULE_SYNC=0 6,18 * * *
SCHEDULE_OSV_CHECK=*/30 * * * *

# OSV／VEX 漏洞資料（網頁上傳或放到放檔目錄）
OSV_INBOX_DIR=/data/inbox
OSV_ARCHIVE_DIR=/data/osv-archive
OSV_KEEP_FILES=5
# 檔案超過幾天沒更新就警告
OSV_STALE_WARN_DAYS=7
# 每個版本至少要有幾筆資料，不足＝檔案有問題、保留舊資料（VEX 也用）
OSV_MIN_ROWS_PER_RELEASE=1000
VEX_INBOX_DIR=/data/vex-inbox
VEX_ARCHIVE_DIR=/data/vex-archive

# 自動下載 OSV／VEX（主機連得到外網或 proxy 才開；完全離線的主機照舊在網頁上傳）
# on＝依排程檢查 Canonical 的兩份檔案，有更新才下載（ETag，沒更新不重抓），放進放檔目錄後自動匯入
CVE_DATA_DOWNLOAD=off
# 檢查時間（cron，時區見 TZ）；Canonical 大約每天更新一次，沒有更新時只問一次、不下載
SCHEDULE_CVE_DATA_DOWNLOAD=17 */6 * * *
OSV_DOWNLOAD_URL=https://security-metadata.canonical.com/osv/osv-all.tar.xz
VEX_DOWNLOAD_URL=https://security-metadata.canonical.com/vex/vex-all.tar.xz
# 只給下載用的 proxy（例 http://proxy.example.com:3128）；留空＝用容器的 HTTPS_PROXY 環境變數（沒有就直連）
DOWNLOAD_PROXY=
# proxy 會攔截 HTTPS（自己的 CA）時：CA 憑證的容器內路徑（檔案放 config/，例 /config/proxy-ca.crt）
DOWNLOAD_CA_FILE=
# 每次讀取的逾時（秒）、單一檔案上限（MB）、一個檔案最多下載幾分鐘（慢到超過就放棄，下次排程再試）
DOWNLOAD_TIMEOUT=60
DOWNLOAD_MAX_MB=500
DOWNLOAD_MAX_MINUTES=30
# 只接受 https（轉址到 http 也拒絕）；內部鏡像只有 http 時才設 true（資料可能被竄改，不建議）
DOWNLOAD_ALLOW_HTTP=false
# 超過幾小時沒有成功檢查就在 /healthz 回報（cve_download_failing）
DOWNLOAD_ALERT_HOURS=48
# 雲端／OEM kernel 變體（linux-aws、linux-azure…）預設不匯入 VEX；主機有用到時列出，可用 *
VEX_KEEP_KERNEL_VARIANTS=

# 資料與報表
DB_PATH=/data/cvehub.sqlite3
REPORT_DIR=/data/reports
# 每次同步後自動輸出的報表：csv | xlsx | json（逗號分隔）
REPORT_FORMATS=csv
# 已解決的比對結果保留天數；也適用於稽核紀錄、同步紀錄、主機清單匯入紀錄、失敗的 OSV／VEX 匯入紀錄
# （成功的 OSV／VEX 匯入紀錄、最新一筆匯入、最近 5 筆與最後一次成功的同步紀錄一律保留）
HISTORY_KEEP_DAYS=365

# 網頁
# 容器內部的位址與 port（不要改；主機的 port 用上面的 WEB_HOST_PORT）
WEB_LISTEN=0.0.0.0
WEB_PORT=8080
# session cookie 名稱：留空＝自動（主機 port 不是 8080 時帶上 port）；同一台主機有其他 cvehub 且登入出現「表單已過期」時可自訂
WEB_COOKIE_NAME=
# 閒置幾分鐘自動登出
WEB_SESSION_IDLE_MINUTES=60
# 放在 HTTPS 反向代理後面時設 true；容器直接提供 HTTPS 時自動開啟
WEB_COOKIE_SECURE=false
# 反向代理的路徑前綴（例 /cvehub）
WEB_BASE_PATH=
# 容器直接提供 HTTPS：憑證與私鑰（例 /config/tls.crt、/config/tls.key）；留空＝HTTP
WEB_TLS_CERT=
WEB_TLS_KEY=
# session 簽章金鑰：留空＝自動產生在 data/.secret_key
WEB_SECRET_KEY=
# 0.5.x 以前的單一帳號（沒有任何帳號時自動轉成管理員）；新安裝不用管
WEB_AUTH_USER=admin
WEB_AUTH_PASSWORD_HASH=CHANGE_ME
# /healthz：超過幾小時沒有成功同步就回報異常
HEALTH_MAX_SYNC_AGE_HOURS=26

# debug | info | warning | error
LOG_LEVEL=info
# 容器連外 proxy（通常不需要）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
