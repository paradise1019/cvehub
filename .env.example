# =====================================================================
# cvehub 設定檔範例（複製成 .env 後修改；.env 不要進 git、權限 600）
# 用途：從 Landscape 取主機與套件、從 kernel API 取執行中 kernel、
#       對照手動匯入的 Canonical OSV（osv-all.tar.xz），產生 CVE 報表
# =====================================================================

# ---------------------------------------------------------------------
# 1. Landscape API（legacy API：GetComputers、GetPackages；24.04／26.04 皆可）
#    建議建立「只有檢視電腦權限」的專用帳號，用它的 API 金鑰
# ---------------------------------------------------------------------
LANDSCAPE_API_URI=https://landscape.example.com/api/
LANDSCAPE_API_KEY=CHANGE_ME
LANDSCAPE_API_SECRET=CHANGE_ME
# Landscape 自簽憑證時，指定 CA 憑證（容器內路徑）；留空＝用系統 CA
LANDSCAPE_CA_FILE=/config/landscape_server_ca.crt
# 只同步符合條件的電腦（Landscape 搜尋語法，例如 tag:prod）；留空＝全部
LANDSCAPE_QUERY=
# API 呼叫逾時（秒）、失敗重試次數
LANDSCAPE_TIMEOUT=300
LANDSCAPE_RETRIES=3

# ---------------------------------------------------------------------
# 2. Kernel API（你的 Django API，提供每台主機目前執行中的 kernel）
#    留空 KERNEL_API_URL＝不使用，kernel 改用「最新安裝的版本」推測
# ---------------------------------------------------------------------
# 兩種模式：
#   bulk     ：KERNEL_API_URL 一次回傳全部主機（清單／DRF 分頁／{主機: {...}}）
#   per-host ：每台主機查一次，URL 裡用 {hostname}、{shortname}、{ip}（會自動 URL 編碼），
#              回應可以是 JSON 物件，或純文字（只有版本，例如 6.8.0-147.147）；404＝查無資料
# URL 可以直接用 IP，例如 http://10.0.0.5:8000/api/kernel/?hostname={hostname}
KERNEL_API_MODE=per-host
KERNEL_API_URL=http://10.0.0.5:8000/api/kernel/?hostname={hostname}
# 認證方式：none | token | basic
KERNEL_API_AUTH=token
KERNEL_API_TOKEN=CHANGE_ME
KERNEL_API_USER=
KERNEL_API_PASSWORD=
KERNEL_API_CA_FILE=
KERNEL_API_TIMEOUT=60
# 回傳 JSON 的欄位名稱（依你的 API 調整）
KERNEL_API_FIELD_HOST=hostname
# 建議提供 /proc/version_signature 的完整版本（例：6.8.0-147.147）；
# 只有 uname -r（例：6.8.0-147-generic）時，會從 Landscape 套件清單查對應版本
KERNEL_API_FIELD_VERSION=kernel_version
KERNEL_API_FIELD_RELEASE=kernel_release
KERNEL_API_FIELD_COLLECTED_AT=collected_at
# kernel 資料超過幾小時視為過期（報表會標示，不採用）
KERNEL_API_MAX_AGE_HOURS=48

# ---------------------------------------------------------------------
# 3. 主機對應：Landscape 與 kernel API 用哪個欄位對上同一台主機
#    hostname   ：完整比對 hostname
#    shortname  ：只比對第一段（lab-c2.example.com → lab-c2）
#    ip         ：Landscape 回報的第一個 IPv4（bulk 模式時，kernel API 的主機欄位要放 IP）
# ---------------------------------------------------------------------
HOST_MATCH_KEY=shortname
# 比對時忽略大小寫
HOST_MATCH_CASE_INSENSITIVE=true

# ---------------------------------------------------------------------
# 4. OSV 漏洞資料（手動放入，程式偵測到新檔就匯入）
#    放檔位置：OSV_INBOX_DIR/osv-all.tar.xz（檔名可帶日期，例 osv-all-20261017.tar.xz）
# ---------------------------------------------------------------------
OSV_INBOX_DIR=/data/inbox
# 匯入成功後移到這裡保存（保留最近幾份）
OSV_ARCHIVE_DIR=/data/osv-archive
OSV_KEEP_FILES=5
# 只匯入這些 Ubuntu 版本（逗號分隔；Pro／ESM 會一併匯入）
UBUNTU_RELEASES=20.04,22.04,24.04
# 檔案超過幾天沒更新就在畫面上警告
OSV_STALE_WARN_DAYS=7
# 匯入檢查：每個版本至少要有幾筆資料（不足＝判定檔案有問題，保留舊資料；VEX 也用這個值）
OSV_MIN_ROWS_PER_RELEASE=1000

# ---------------------------------------------------------------------
# 4b. VEX 官方處理狀態（輸出報表、受影響主機用；跟 OSV 一起下載更新）
#     https://security-metadata.canonical.com/vex/vex-all.tar.xz
#     放檔位置：VEX_INBOX_DIR/vex-all.tar.xz；沒有匯入時輸出報表只分已修正／受影響
# ---------------------------------------------------------------------
VEX_INBOX_DIR=/data/vex-inbox
VEX_ARCHIVE_DIR=/data/vex-archive
# 雲端／OEM kernel 變體（linux-aws、linux-azure…）預設不匯入（佔 VEX 約 87% 的資料量）；
# 主機有用到時列出名稱，可用 *，例：linux-aws*,linux-azure
VEX_KEEP_KERNEL_VARIANTS=

# ---------------------------------------------------------------------
# 5. 比對規則
# ---------------------------------------------------------------------
# Ubuntu Pro：auto（看 Landscape 回報的 Pro 狀態，沒有時看 +esm 版本）| yes | no
PRO_MODE=auto
# 是否列出「尚未有修正」的 CVE（數量很多，主要是 kernel）
INCLUDE_UNFIXED=false
# 報表最低等級：negligible | low | medium | high | critical
MIN_PRIORITY=low
# 沒有 kernel API 資料時，舊 kernel 套件是否也檢查
CHECK_OLD_KERNELS=false

# ---------------------------------------------------------------------
# 6. 排程（容器內建排程，cron 格式，時區見 TZ）
# ---------------------------------------------------------------------
TZ=Asia/Taipei
SCHEDULE_SYNC=0 6,18 * * *
# 檢查 OSV_INBOX_DIR 是否有新檔
SCHEDULE_OSV_CHECK=*/30 * * * *

# ---------------------------------------------------------------------
# 7. 資料與報表
# ---------------------------------------------------------------------
DB_PATH=/data/cvehub.sqlite3
REPORT_DIR=/data/reports
# 每次同步後自動輸出的報表格式（逗號分隔）：csv | xlsx | json
REPORT_FORMATS=csv
# 歷史資料保留天數
HISTORY_KEEP_DAYS=365

# ---------------------------------------------------------------------
# 8. 網頁
# ---------------------------------------------------------------------
WEB_LISTEN=0.0.0.0
WEB_PORT=8080
# 網頁登入（basic auth）；密碼請放雜湊值，不要放明碼
# 產生：docker compose run --rm cvehub python -m cvehub.cli hash-password
# ⚠️ 雜湊值裡的每個 $ 要寫成 $$（docker compose 會把 $ 當變數）
WEB_AUTH_USER=admin
WEB_AUTH_PASSWORD_HASH=CHANGE_ME
# 反向代理後面時的路徑前綴（例 /cvehub）；直接存取留空
WEB_BASE_PATH=
# HTTPS：容器內的憑證與私鑰路徑（例 /config/tls.crt、/config/tls.key）；留空＝HTTP
WEB_TLS_CERT=
WEB_TLS_KEY=
# /healthz：超過幾小時沒有成功同步就回報異常（同步排程一天兩次時建議 26）
HEALTH_MAX_SYNC_AGE_HOURS=26

# ---------------------------------------------------------------------
# 9. 其他
# ---------------------------------------------------------------------
# debug | info | warning | error
LOG_LEVEL=info
# 連外 proxy（容器本身通常不需要連外；Landscape／kernel API 在內網時留空）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
